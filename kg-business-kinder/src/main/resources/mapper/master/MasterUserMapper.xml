<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.business.kinder.mapper.master.MasterUserMapper">
    <select id="selectEnabledNicknameByUserId" resultType="java.lang.String">
        SELECT nickname
        FROM sys_user
        WHERE id = #{userId}
          AND delete_status = 0
          AND status = 1
        LIMIT 1
    </select>
</mapper>
