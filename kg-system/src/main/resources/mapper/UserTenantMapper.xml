<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.system.mapper.UserTenantMapper">
    <!--@Table sys_user_tenant-->
    <resultMap id="BaseResultMap" type="com.kgplatform.system.domain.dto.UserTenantDto">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="identity_type" property="identityType"/>
        <result column="default_flag" property="defaultFlag"/>
        <result column="status" property="status"/>
        <result column="delete_status" property="deleteStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, tenant_id, identity_type, default_flag, status, delete_status, create_by, create_time, last_modified_by, last_modified_time
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM sys_user_tenant
        <where>
            1=1
            AND delete_status = 0
            <if test="null != vo.bindUserId">
                AND user_id = #{vo.bindUserId}
            </if>
            <if test="null != vo.bindTenantId">
                AND tenant_id = #{vo.bindTenantId}
            </if>
            <if test="null != vo.identityType and '' != vo.identityType">
                AND identity_type = #{vo.identityType}
            </if>
            <if test="null != vo.status">
                AND status = #{vo.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
</mapper>

