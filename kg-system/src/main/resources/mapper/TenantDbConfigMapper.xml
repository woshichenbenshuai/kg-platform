<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.system.mapper.TenantDbConfigMapper">
    <!--@Table tenant_db_config-->
    <resultMap id="BaseResultMap" type="com.kgplatform.system.domain.dto.TenantDbConfigDto">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="db_host" property="dbHost"/>
        <result column="db_port" property="dbPort"/>
        <result column="db_name" property="dbName"/>
        <result column="db_username" property="dbUsername"/>
        <result column="db_password" property="dbPassword"/>
        <result column="status" property="status"/>
        <result column="delete_status" property="deleteStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, tenant_id, db_host, db_port, db_name, db_username, db_password, status, delete_status, create_by, create_time, last_modified_by, last_modified_time
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM tenant_db_config
        <where>
            1=1
            AND delete_status = 0
            <if test="null != vo.bindTenantId">
                AND tenant_id = #{vo.bindTenantId}
            </if>
            <if test="null != vo.status">
                AND status = #{vo.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectAllByTenantId" resultType="com.kgplatform.system.domain.po.TenantDbConfig">
        SELECT
            <include refid="Base_Column_List"/>
        FROM tenant_db_config
        WHERE tenant_id = #{tenantId}
        ORDER BY create_time DESC
    </select>

    <update id="updateProvisioningConfig">
        UPDATE tenant_db_config
        SET db_host = #{dbHost},
            db_port = #{dbPort},
            db_name = #{dbName},
            db_username = #{dbUsername},
            db_password = #{dbPassword},
            status = #{status},
            delete_status = #{deleteStatus},
            last_modified_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>

