<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.system.mapper.MenuMapper">
    <!--@Table sys_menu-->
    <resultMap id="BaseResultMap" type="com.kgplatform.system.domain.dto.MenuDto">
        <id column="id" property="id"/>
        <result column="menu_code" property="menuCode"/>
        <result column="menu_name" property="menuName"/>
        <result column="menu_scope" property="menuScope"/>
        <result column="parent_id" property="parentId"/>
        <result column="route_path" property="routePath"/>
        <result column="component_path" property="componentPath"/>
        <result column="icon" property="icon"/>
        <result column="visible" property="visible"/>
        <result column="keep_alive" property="keepAlive"/>
        <result column="sort_no" property="sortNo"/>
        <result column="remarks" property="remarks"/>
        <result column="status" property="status"/>
        <result column="delete_status" property="deleteStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, menu_code, menu_name, menu_scope, parent_id, route_path, component_path, icon, visible, keep_alive, sort_no, remarks, status, delete_status, create_by, create_time, last_modified_by, last_modified_time
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM sys_menu
        <where>
            1=1
            AND delete_status = 0
            <if test="null != vo.menuName and '' != vo.menuName">
                AND menu_name LIKE CONCAT('%', #{vo.menuName}, '%')
            </if>
            <if test="null != vo.menuCode and '' != vo.menuCode">
                AND menu_code = #{vo.menuCode}
            </if>
            <if test="null != vo.menuScope and '' != vo.menuScope">
                AND menu_scope = #{vo.menuScope}
            </if>
            <if test="null != vo.status">
                AND status = #{vo.status}
            </if>
        </where>
        ORDER BY sort_no ASC, create_time DESC
    </select>
</mapper>

