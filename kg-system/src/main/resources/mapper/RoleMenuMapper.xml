<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.system.mapper.RoleMenuMapper">
    <!--@Table role_menu-->
    <resultMap id="BaseResultMap" type="com.kgplatform.system.domain.dto.RoleMenuDto">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="menu_id" property="menuId"/>
        <result column="status" property="status"/>
        <result column="delete_status" property="deleteStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, role_id, menu_id, status, delete_status, create_by, create_time, last_modified_by, last_modified_time
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role_menu
        <where>
            1=1
            AND delete_status = 0
            <if test="null != vo.bindRoleId">
                AND role_id = #{vo.bindRoleId}
            </if>
            <if test="null != vo.bindMenuId">
                AND menu_id = #{vo.bindMenuId}
            </if>
            <if test="null != vo.status">
                AND status = #{vo.status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <select id="selectAllByRoleId" resultType="com.kgplatform.system.domain.po.RoleMenu">
        SELECT
            <include refid="Base_Column_List"/>
        FROM role_menu
        WHERE role_id = #{roleId}
    </select>

    <update id="updateRelationState">
        UPDATE role_menu
        SET status = #{status},
            delete_status = #{deleteStatus},
            last_modified_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>

