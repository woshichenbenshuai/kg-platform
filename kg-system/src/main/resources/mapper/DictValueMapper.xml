<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kgplatform.system.mapper.DictValueMapper">
    <!--@Table dict_value-->
    <resultMap id="BaseResultMap" type="com.kgplatform.system.domain.dto.DictValueDto">
        <id column="id" property="id"/>
        <result column="type" property="type"/>
        <result column="dict_type_id" property="dictTypeId"/>
        <result column="label" property="label"/>
        <result column="value" property="value"/>
        <result column="remarks" property="remarks"/>
        <result column="status" property="status"/>
        <result column="delete_status" property="deleteStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, `type`, dict_type_id, label, `value`, remarks, status, delete_status, create_by, create_time, last_modified_by, last_modified_time
    </sql>

    <select id="selectPageList" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM dict_value
        <where>
            1=1
            AND status = 1
            AND delete_status = 0
            <if test="null != vo.type and '' != vo.type">
                AND `type` = #{vo.type}
            </if>
            <if test="null != vo.dictTypeId">
                AND dict_type_id = #{vo.dictTypeId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <update id="updateDictTypeCode">
        update dict_value set type = #{code} where dict_type_id = #{id}
    </update>

    <update id="deleteByDictTypeId">
        update dict_value set delete_status = 1 where dict_type_id = #{id}
    </update>

</mapper>


